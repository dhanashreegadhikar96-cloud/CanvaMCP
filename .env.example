# Gemini (reads chat messages and calls Canva's tools)
GEMINI_API_KEY=

# Canva Developer Portal app: Outside Canva > Configuration > Credentials
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Must exactly match a URL under Outside Canva > Redirect URLs. Locally use 127.0.0.1, not localhost.
# On Vercel: https://<your-app>.vercel.app/api/auth/canva/callback (and add that URL in the portal too)
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/auth/canva/callback

# No access token here: users click "Connect" and the app keeps their token (httpOnly cookies).
