# Gemini (reads chat messages and calls Canva's tools)
GEMINI_API_KEY=

# Canva Developer Portal app: Outside Canva > Configuration > Credentials
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Leave unset: the app uses its own address (127.0.0.1 locally, your domain when deployed).
# Add both callbacks under Outside Canva > Redirect URLs in the Canva Developer Portal:
#   http://127.0.0.1:3000/api/auth/canva/callback
#   https://<your-app>.vercel.app/api/auth/canva/callback
# Only set this to force one address (it must exactly match a portal Redirect URL):
# CANVA_REDIRECT_URI=https://<your-app>.vercel.app/api/auth/canva/callback

# Canva editor (MCP) sign-in. Two ways:
#  - Default: the app self-registers with mcp.canva.com. Canva only accepts 127.0.0.1 return addresses
#    this way, so it works locally but NOT on a deployed site ("Invalid redirect URI").
#  - Deployed sites: in the Developer Portal turn on "Canva MCP" for your app (Outside Canva >
#    Configuration > Integration methods), then set the line below. The normal Canva sign-in then also
#    covers the editor (Canva's MCP server at api.canva.com/connect/v1/mcp); no extra redirect URL needed.
# CANVA_MCP_USE_PORTAL_APP=true

# No access token here: users click "Connect" and the app keeps their token (httpOnly cookies).
